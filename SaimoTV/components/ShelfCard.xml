<?xml version="1.0" encoding="utf-8" ?>
<component name="ShelfCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="showItem" />
        <field id="focusPercent" type="float" onChange="updateFocus" />
        <field id="itemHasFocus" type="boolean" onChange="updateFocus" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <script type="text/brightscript" uri="pkg:/components/ShelfCard.brs" />

    <children>
        <Label visible="false">
            <Font id="shelfCardFont" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" />
        </Label>
        <Poster id="poster" translation="[4, 4]" width="186" height="279"
                loadDisplayMode="scaleToFill"
                loadingBitmapUri="pkg:/images/placeholder.png"
                failedBitmapUri="pkg:/images/placeholder.png" />
        <Poster id="focusHalo" translation="[0, 0]" width="186" height="279"
                uri="pkg:/images/focus_shelf.png" opacity="0" loadSync="true" />
        <Label id="cardTitle" translation="[4, 288]" width="180" height="40"
               font="dictionary:shelfCardFont" color="0xF7F3FFFF" wrap="true" />
    </children>
</component>
