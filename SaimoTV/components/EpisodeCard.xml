<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="showItem" />
        <field id="focusPercent" type="float" onChange="updateFocus" />
        <field id="itemHasFocus" type="boolean" onChange="updateFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <script type="text/brightscript" uri="pkg:/components/EpisodeCard.brs" />
    <children>
        <Label visible="false"><Font id="episodeNumberFont" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="64" /></Label>
        <Label visible="false"><Font id="episodeTitleFont" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
        <Label visible="false"><Font id="episodeMetaFont" role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="20" /></Label>
        <Label visible="false"><Font id="episodeBadgeFont" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="18" /></Label>
        <Rectangle id="cardBg" width="396" height="310" color="0x0B0E14D9" />
        <Poster id="poster" translation="[8, 8]" width="380" height="214" loadDisplayMode="scaleToZoom"
                loadingBitmapUri="pkg:/images/placeholder.png"
                failedBitmapUri="pkg:/images/placeholder.png" />
        <Label id="episodeNumber" translation="[8, 8]" width="380" height="214"
               font="dictionary:episodeNumberFont" color="0x4FE3D0FF"
               horizAlign="center" vertAlign="center" text="" visible="false" />
        <Rectangle id="episodeCodeBg" translation="[108, 16]" width="264" height="32" color="0x0B0E14BF" />
        <Label id="episodeCode" translation="[116, 19]" width="248" height="26"
               font="dictionary:episodeBadgeFont" color="0x4FE3D0FF" horizAlign="center" text="" />
        <Label id="title" translation="[12, 226]" width="372" height="34"
               font="dictionary:episodeTitleFont" color="0xFFFFFFFF" maxLines="1" text="" />
        <Label id="meta" translation="[12, 260]" width="372" height="24"
               font="dictionary:episodeMetaFont" color="0xA8B4C0FF" maxLines="1" text="" />
        <Label id="synopsis" translation="[12, 284]" width="372" height="24"
               font="dictionary:episodeMetaFont" color="0x66FFFFFF" maxLines="1" text="" />
        <Poster id="focusHalo" width="396" height="310" uri="pkg:/images/focus_episode.png"
                opacity="0" loadSync="true" />
    </children>
</component>
