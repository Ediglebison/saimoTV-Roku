<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerOSD" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onDataChange" />
    <field id="subtitle" type="string" onChange="onDataChange" />
    <field id="positionSec" type="integer" value="0" onChange="onPositionChange" />
    <field id="durationSec" type="integer" value="0" onChange="onPositionChange" />
    <field id="isPlaying" type="boolean" value="true" onChange="onStateChange" />
    <field id="isSeries" type="boolean" value="false" onChange="onDataChange" />
    <field id="skipIntroRequested" type="boolean" value="false" alwaysNotify="true" />
    <field id="playPauseRequested" type="boolean" value="false" alwaysNotify="true" />
    <field id="seekRequested" type="integer" value="0" alwaysNotify="true" />
    <field id="isOpen" type="boolean" value="false" onChange="onOpenChange" />
  </interface>

  <children>
    <Group id="osdContainer" visible="false">
      <!-- Gradiente inferior escuro -->
      <Poster translation="[0, 440]" width="1920" height="640" uri="pkg:/images/degrade_baixo.png" />

      <!-- Topo do OSD: Título e Detalhes -->
      <Label id="titleLabel" translation="[80, 790]" width="1400" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="44" /></Label>
      <Label id="subLabel" translation="[80, 845]" width="1200" text="Detalhes" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>

      <!-- Botão Pular Abertura (+85s) -->
      <Group id="skipIntroBtn" translation="[1560, 800]" visible="false">
        <Poster id="skipIntroBg" width="300" height="72" uri="pkg:/images/p_btn.9.png" />
        <Label id="skipIntroText" width="300" height="72" vertAlign="center" text="Pular abertura" color="#0b0e14" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
      </Group>

      <!-- Barra de Progresso / Scrub Bar -->
      <Group translation="[80, 920]">
        <Rectangle width="1760" height="8" color="#FFFFFF33" />
        <Rectangle id="progressBar" width="0" height="8" color="#4FE3D0" />
        <Rectangle id="scrubHead" translation="[0, -4]" width="16" height="16" color="#FFFFFF" />
      </Group>

      <!-- Contadores de Tempo -->
      <Label id="timeCurrentLabel" translation="[80, 945]" text="00:00" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>
      <Label id="timeRemainingLabel" translation="[1720, 945]" width="120" text="-00:00" color="#94a3b8" horizAlign="right"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>

      <!-- Controles inferiores com botões -->
      <Label translation="[80, 990]" width="1760" text="OK pausa  ·  esquerda volta, direita avança 10 s  ·  * áudio, legendas e fontes" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>
      <Label id="btnPlayPause" visible="false" />
    </Group>

    <!-- Timer para auto-esconder OSD -->
    <Timer id="hideTimer" duration="5.0" repeat="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Format.brs" />
  <script type="text/brightscript" uri="pkg:/components/views/PlayerOSD.brs" />
</component>
