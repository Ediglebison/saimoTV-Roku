<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelDrawer" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="onChannelsChange" />
    <field id="epgMap" type="assocarray" onChange="onEpgChange" />
    <field id="selectedIndex" type="integer" value="0" />
    <field id="channelSelected" type="assocarray" alwaysNotify="true" />
    <field id="isOpen" type="boolean" value="false" onChange="onOpenChange" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <field id="fontesRequested" type="assocarray" alwaysNotify="true" />
    <field id="menuRequested" type="assocarray" alwaysNotify="true" />
  </interface>

  <children>
    <Group id="painel" visible="false">
      <Rectangle width="1920" height="1080" color="#0b0e14F2" />
      <Label translation="[64, 168]" text="Canais" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="52" /></Label>
      <Label id="contaGrupo" translation="[520, 172]" width="170" horizAlign="right" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="36" /></Label>
      <Label id="contaTotal" translation="[700, 172]" width="96" horizAlign="right" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="36" /></Label>

      <Group translation="[0, 264]" clippingRect="[0, -8, 840, 90]">
        <Group id="chips" translation="[32, 0]" />
      </Group>

      <MarkupList id="channelList" translation="[20, 342]" itemComponentName="CanalItem" itemSize="[810, 172]" itemSpacing="[0, 4]" numRows="3" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
      <Label translation="[60, 950]" width="760" wrap="true" numLines="2" text="OK assiste  ·  esquerda: seções  ·  direita: fontes  ·  * menu" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>

      <!-- Prévia: o vídeo fica por baixo, nesta janela -->
      <Poster translation="[944, 708]" width="880" height="290" uri="pkg:/images/p_chip.9.png" />
      <Label id="infoCanal" translation="[988, 750]" width="800" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
      <Label id="infoPrograma" translation="[988, 800]" width="800" maxLines="1" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="42" /></Label>
      <Label id="infoHora" translation="[988, 868]" width="800" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /></Label>
      <Label id="infoSeguir" translation="[988, 910]" width="800" maxLines="1" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /></Label>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/views/ChannelDrawer.brs" />
</component>
