<?xml version="1.0" encoding="utf-8" ?>
<component name="ZapHUD" extends="Group">
  <interface>
    <field id="channelNumber" type="string" onChange="onDataChange" />
    <field id="channelName" type="string" onChange="onDataChange" />
    <field id="channelLogo" type="string" onChange="onDataChange" />
    <field id="programTitle" type="string" onChange="onDataChange" />
    <field id="programProgress" type="float" onChange="onDataChange" />
    <field id="linhaHora" type="string" onChange="onDataChange" />
    <field id="visibleTimer" type="boolean" value="false" />
    <function name="alternar" />
  </interface>

  <children>
    <Group id="hudContainer" visible="false">
      <Poster translation="[0, 440]" width="1920" height="640" uri="pkg:/images/degrade_baixo.png" />
      <Poster translation="[110, 770]" width="150" height="150" uri="pkg:/images/p_chip.9.png" />
      <Poster id="logoPoster" translation="[122, 782]" width="126" height="126" loadWidth="126" loadHeight="126" loadDisplayMode="scaleToFit" />
      <Label id="numLabel" translation="[300, 708]" text="1" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="40" /></Label>
      <Label id="nameLabel" translation="[380, 708]" width="1200" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="40" /></Label>
      <Label id="progLabel" translation="[300, 790]" width="1500" maxLines="1" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="34" /></Label>
      <Rectangle translation="[300, 860]" width="1500" height="6" color="#FFFFFF33" />
      <Rectangle id="progBar" translation="[300, 860]" width="0" height="6" color="#4FE3D0" />
      <Label translation="[300, 880]" width="1500" text="OK esconde  ·  segure OK: menu  ·  esquerda canais  ·  direita fontes  ·  cima/baixo troca" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="26" /></Label>
      <Label id="horaLabel" translation="[300, 940]" width="1500" maxLines="1" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /></Label>
    </Group>
    <Timer id="hideTimer" duration="4" repeat="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/ZapHUD.brs" />
</component>