<?xml version="1.0" encoding="utf-8" ?>
<component name="FavoritesScreen" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="refreshFavorites" />
    <field id="vodItems" type="array" onChange="refreshFavorites" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <Label translation="[100, 128]" text="Favoritos" color="#F7F7FA"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="52" /></Label>
    <Label id="countLabel" translation="[350, 150]" text="" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="26" /></Label>
    <Label id="emptyState" translation="[0, 520]" width="1920" horizAlign="center" wrap="true" text="Nada nos favoritos ainda.&#10;Aperte * num canal ou título para favoritar." color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="34" /></Label>
    <RowList
      id="favoritesRowList"
      itemComponentName="PosterItem"
      translation="[100, 230]"
      itemSize="[1820, 480]"
      rowHeights="[480]"
      rowItemSize="[[272, 460]]"
      rowItemSpacing="[[32, 0]]"
      itemSpacing="[0, 28]"
      showRowLabel="[true]"
      rowLabelOffset="[[12, 18]]"
      rowLabelColor="#F7F7FA"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      drawFocusFeedback="false"
      numRows="2"
      wrap="false"
    ><Font role="rowLabelFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="36" /></RowList>
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Rows.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FavoritesScreen.brs" />
</component>