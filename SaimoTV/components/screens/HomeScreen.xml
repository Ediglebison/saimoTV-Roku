<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onFeaturedChange" />
    <field id="railsData" type="array" onChange="onRailsChange" />
    <field id="channels" type="array" onChange="onRailsChange" />
    <field id="epgMap" type="assocarray" />
    <field id="vodItems" type="array" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <HeroBanner id="heroBanner" translation="[0, 0]" />
    <RowList
      id="contentRowList"
      itemComponentName="PosterItem"
      translation="[100, 430]"
      itemSize="[1820, 480]"
      rowHeights="[480]"
      rowItemSize="[[272, 460]]"
      rowItemSpacing="[[32, 0]]"
      itemSpacing="[0, 28]"
      showRowLabel="[true]"
      rowLabelOffset="[[12, 18]]"
      rowLabelColor="#F7F7FA"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      drawFocusFeedback="false"
      numRows="2"
      wrap="false"
    ><Font role="rowLabelFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="36" /></RowList>
    <Timer id="heroTimer" duration="0.3" repeat="false" />
    <Timer id="montarTimer" duration="0.15" repeat="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Rows.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>