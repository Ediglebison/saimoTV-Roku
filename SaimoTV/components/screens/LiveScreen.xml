<?xml version="1.0" encoding="utf-8" ?>
<component name="LiveScreen" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="onChannelsChange" />
    <field id="epgMap" type="assocarray" onChange="onEpgChange" />
    <field id="arvore" type="node" onChange="onArvore" />
    <field id="currentChannelIndex" type="integer" value="0" onChange="onChannelIndexChange" />
    <field id="openDrawerOnLoad" type="boolean" value="false" />
    <field id="telaCheia" type="boolean" />
    <field id="guiaRequested" type="boolean" alwaysNotify="true" />
    <field id="sairRequested" type="boolean" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <ChannelDrawer id="channelDrawer" />

    <!-- Player de Vídeo Nativo por Hardware: tela cheia ou janela de prévia -->
    <Video id="liveVideo" width="1920" height="1080" translation="[0, 0]" enableUI="false" />

    <!-- Indicador de Carregando / Buffer -->
    <Group id="bufferingGroup" translation="[840, 500]" visible="false">
      <Rectangle translation="[-40, -20]" width="300" height="80" color="#000000D0" />
      <Label text="Carregando canal..." color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
    </Group>

    <!-- ZapHUD (Mini Informações ao Trocar de Canal) -->
    <ZapHUD id="zapHud" />

    <!-- Toast de Favorito (*) -->
    <Group id="favoriteToast" translation="[760, 60]" visible="false">
      <Rectangle width="400" height="60" color="#0b0e14F0" />
      <Rectangle width="400" height="3" color="#FFB454" />
      <Label id="favoriteToastText" translation="[0, 18]" width="400" text="[*] Canal Favoritado" color="#FFB454" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>
    </Group>
    <Timer id="favoriteToastTimer" duration="2.5" repeat="false" />

    <Rectangle id="fundoFontes" width="1040" height="1080" color="#0b0e14" visible="false" />
    <PainelLateral id="painelFontes" />
    <Timer id="holdTimer" duration="0.6" repeat="false" />
    <Timer id="zapTimer" duration="0.4" repeat="false" />
    <Timer id="vigiaTimer" duration="8" repeat="false" />
    <Group id="ancora" focusable="true" />
    <Timer id="sonoTimer" repeat="false" />

    <!-- Modal de PIN Parental -->
    <PinModal id="pinModal" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/LeitorM3u.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/LiveScreen.brs" />
</component>
