<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playItem" type="assocarray" onChange="onPlayItemChange" />
    <field id="exitRequested" type="boolean" value="false" />
    <function name="cleanUp" />
  </interface>

  <children>
    <!-- Player de Vídeo Nativo por Hardware -->
    <Video id="videoPlayer" width="1920" height="1080" translation="[0, 0]" enableUI="false" />

    <!-- Indicador de Buffer / Carregamento -->
    <Group id="bufferingGroup" translation="[820, 500]" visible="false">
      <Rectangle translation="[-40, -20]" width="360" height="80" color="#000000D0" />
      <Label text="Carregando vídeo..." color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
    </Group>

    <!-- Indicador de Erro -->
    <Group id="errorGroup" translation="[700, 480]" visible="false">
      <Rectangle translation="[-30, -20]" width="580" height="120" color="#0b0e14F0" />
      <Rectangle translation="[-30, -20]" width="580" height="3" color="#e11d48" />
      <Label id="errorLabel" translation="[0, 15]" width="520" text="Vídeo indisponível no momento" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
      <Label translation="[0, 60]" width="520" text="Pressione [Voltar] no controle remoto" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
    </Group>

    <!-- OSD Customizado Completo -->
    <PlayerOSD id="playerOsd" />

    <!-- Timer de salvamento de progresso a cada 5 segundos -->
    <Timer id="progressTimer" duration="5.0" repeat="true" />
    <PainelLateral id="painelOpcoes" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
</component>
