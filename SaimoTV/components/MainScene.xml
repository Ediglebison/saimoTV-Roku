<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="deepLink" type="assocarray" onChange="onDeepLinkChange" />
    <field id="sairDoApp" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Poster id="appBg" translation="[0, 0]" width="1920" height="1080" uri="pkg:/images/bg_app.png" loadSync="true" />
    <Group id="screensContainer" />
    <TopNavBar id="topNavBar" />
    <Timer id="vodRefreshTimer" duration="900" repeat="true" />
    <Group visible="false">
      <Label visible="false"><Font id="fontMeta" role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="18" /></Label>
      <Label visible="false"><Font id="fontBody" role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="24" /></Label>
      <Label visible="false"><Font id="fontLabel" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>
      <Label visible="false"><Font id="fontHeading" role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
      <Label visible="false"><Font id="fontDisplay" role="font" uri="pkg:/fonts/Roboto-Bold.ttf" size="36" /></Label>
      <Label visible="false"><Font id="fontTitle" role="font" uri="pkg:/fonts/Roboto-Bold.ttf" size="48" /></Label>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>