<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChange" />
    <field id="width" type="float" value="280" />
    <field id="height" type="float" value="200" />
    <field id="rowFocusPercent" type="float" onChange="onFocusChange" />
  </interface>

  <children>
    <Rectangle id="focusBorder" translation="[-3, -3]" width="286" height="146" color="#4FE3D0" visible="false" />
    <Rectangle width="280" height="140" color="#1e293b" />
    <Poster id="thumb" width="280" height="140" loadDisplayMode="scaleToZoom" />
    <Rectangle translation="[0, 108]" width="280" height="32" color="#000000CC" />
    <Label id="epBadge" translation="[8, 114]" width="264" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>
    <Label id="title" translation="[2, 146]" width="276" height="24" color="#FFFFFF" numLines="1"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>
    <Label id="subInfo" translation="[2, 172]" width="276" height="22" color="#94a3b8" text="Full HD • Áudio Dublado"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
  </children>

  <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/items/EpisodeItem.brs" />
</component>
